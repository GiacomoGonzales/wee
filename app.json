{
  "expo": {
    "name": "Weë",
    "slug": "hidetok-simple",
    "scheme": "wee",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "jsEngine": "hermes",
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "zone.wee.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "enableHermes": true,
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0A0A"
      },
      "userInterfaceStyle": "automatic",
      "backgroundColor": "#0A0A0A",
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "wee.zone",
              "pathPrefix": "/post"
            },
            {
              "scheme": "https",
              "host": "www.wee.zone",
              "pathPrefix": "/post"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "runtimeVersion": "1.0.0"
    },
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "zone.wee.app",
      "supportsTablet": false,
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0A0A",
        "dark": {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      },
      "userInterfaceStyle": "automatic",
      "backgroundColor": "#0A0A0A",
      "associatedDomains": [
        "applinks:wee.zone",
        "applinks:www.wee.zone"
      ],
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "NSCameraUsageDescription": "Weë necesita acceso a tu cámara para que puedas tomar fotos y videos para compartir en tus publicaciones.",
        "NSMicrophoneUsageDescription": "Weë necesita acceso a tu micrófono para grabar audio en tus videos.",
        "NSPhotoLibraryUsageDescription": "Weë necesita acceso a tu galería para que puedas seleccionar fotos y videos para compartir.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Weë - La comunidad del futuro",
      "shortName": "Weë",
      "description": "Comparte de forma real y anónima con Weë. Crea tu alter ego digital, opina libremente y conecta con una comunidad sin filtros.",
      "backgroundColor": "#0A0A0A",
      "themeColor": "#F5B731",
      "orientation": "portrait-primary"
    },
    "extra": {
      "eas": {
        "projectId": "31297521-34c6-4238-af4f-e663953af31f"
      }
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F5B731",
          "defaultChannel": "default"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.600935858829-f92ar5236mquqjdnpumddlpkp87qqfdm"
        }
      ],
      "react-native-compressor"
    ],
    "owner": "giacomogonzales",
    "updates": {
      "url": "https://u.expo.dev/31297521-34c6-4238-af4f-e663953af31f"
    }
  }
}
